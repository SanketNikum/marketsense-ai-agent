# Copy this file to .env and fill in real values.
# .env is git-ignored - never commit real keys.

# Free tier LLM APIs (get keys from their respective consoles)
GEMINI_API_KEY=
GROQ_API_KEY=

# Optional - only needed if you want Claude for final generation quality
ANTHROPIC_API_KEY=

# LangSmith tracing (free tier, 5000 traces/month)
# NOTE: some accounts are provisioned on a region-specific data plane
# (e.g. AWS) that requires LANGSMITH_ENDPOINT set explicitly, or every
# request 403s even with a valid key. Check your LangSmith dashboard's
# quickstart snippet for the correct endpoint if tracing doesn't work.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://aws.api.smith.langchain.com
LANGSMITH_PROJECT=MarketSense
